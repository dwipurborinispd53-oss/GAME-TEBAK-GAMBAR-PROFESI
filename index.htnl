<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Game Tebak Profesi PAUD</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Fredoka', sans-serif;
            background-color: #f0fdfa; /* Light teal background */
            background-image: radial-gradient(#bae6fd 20%, transparent 20%), radial-gradient(#bae6fd 20%, transparent 20%);
            background-color: #e0f2fe;
            background-position: 0 0, 25px 25px;
            background-size: 50px 50px;
            overflow-x: hidden;
            touch-action: manipulation; /* Prevent zoom on double tap */
        }

        /* Animations */
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }
        @keyframes pop {
            0% { transform: scale(0.8); opacity: 0; }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); opacity: 1; }
        }

        .animate-bounce-custom { animation: bounce 1s infinite; }
        .animate-shake { animation: shake 0.4s ease-in-out; }
        .animate-pop { animation: pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }

        /* Game Elements */
        .btn-game {
            transition: all 0.2s;
            box-shadow: 0 6px 0 rgba(0,0,0,0.2);
        }
        .btn-game:active {
            transform: translateY(6px);
            box-shadow: 0 0 0 rgba(0,0,0,0.2);
        }
        
        .letter-block {
            cursor: grab;
            transition: transform 0.1s;
        }
        .letter-block:active {
            cursor: grabbing;
        }
        .letter-slot {
            border: 4px dashed #94a3b8;
            background: rgba(255,255,255,0.5);
            transition: all 0.2s;
        }
        .letter-slot.drag-over {
            background: #fef08a;
            border-color: #eab308;
            transform: scale(1.05);
        }

        /* Hide elements utility */
        .hidden-screen { display: none !important; }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">

    <!-- Audio Context Warning (For SpeechSynthesis) -->
    <div id="audio-warning" class="fixed top-0 left-0 w-full bg-yellow-400 text-yellow-900 text-center p-2 font-bold z-50 text-sm md:text-base">
        Klik layar atau tombol di bawah agar suara bisa menyala ya! 🔊
    </div>

    <!-- MAIN CONTAINER -->
    <div class="max-w-2xl w-full bg-white/90 backdrop-blur-sm rounded-3xl shadow-2xl border-8 border-white p-4 md:p-8 relative overflow-hidden">
        
        <!-- HOME SCREEN -->
        <div id="screen-home" class="flex flex-col items-center justify-center space-y-8 animate-pop">
            <h1 class="text-4xl md:text-5xl font-bold text-center text-blue-600 drop-shadow-md leading-tight">
                🌟 Tebak Profesi 🌟
            </h1>
            <div class="text-8xl md:text-9xl animate-bounce-custom flex gap-4">
                👨‍⚕️ 👮‍♂️ 👩‍🏫
            </div>
            <p class="text-xl text-gray-600 text-center font-semibold">Belajar nama-nama pekerjaan yuk!</p>
            <button onclick="showScreen('screen-levels'); speak('Pilih permainan!')" 
                    class="btn-game bg-green-500 hover:bg-green-400 text-white text-3xl font-bold py-4 px-10 rounded-full w-full max-w-sm">
                MAIN SEKARANG!
            </button>
        </div>

        <!-- LEVEL SELECTION SCREEN -->
        <div id="screen-levels" class="hidden-screen flex-col items-center justify-center space-y-6 animate-pop">
            <h2 class="text-3xl md:text-4xl font-bold text-center text-purple-600 mb-4">Pilih Level Main</h2>
            
            <button onclick="startLevel(1)" class="btn-game bg-blue-500 text-white text-2xl font-bold py-6 px-6 rounded-2xl w-full flex items-center justify-between border-4 border-blue-600">
                <span class="text-left">
                    <span class="block text-3xl mb-1">Level 1 🥇</span>
                    <span class="text-lg font-normal">Tebak Gambar Pekerjaan</span>
                </span>
                <span class="text-6xl">🤔</span>
            </button>

            <button onclick="startLevel(2)" class="btn-game bg-orange-500 text-white text-2xl font-bold py-6 px-6 rounded-2xl w-full flex items-center justify-between border-4 border-orange-600">
                <span class="text-left">
                    <span class="block text-3xl mb-1">Level 2 🥈</span>
                    <span class="text-lg font-normal">Tebak Tempat Kerja</span>
                </span>
                <span class="text-6xl">🏫</span>
            </button>

            <button onclick="showScreen('screen-home')" class="mt-4 text-gray-500 font-bold text-xl hover:text-gray-700">
                ⬅️ Kembali
            </button>
        </div>

        <!-- GAME SCREEN: LEVEL 1 (TEBAK GAMBAR) -->
        <div id="screen-level-1" class="hidden-screen flex-col items-center w-full animate-pop">
            <div class="w-full flex justify-between items-center mb-6">
                <button onclick="showScreen('screen-levels')" class="text-gray-500 text-3xl">🏠</button>
                <div class="bg-yellow-400 text-yellow-900 font-bold px-4 py-2 rounded-full text-xl" id="l1-score">⭐ 0/5</div>
            </div>

            <h2 class="text-2xl md:text-3xl font-bold text-center text-blue-600 mb-6" id="l1-question-text">
                Siapakah ini?
            </h2>

            <div class="text-[120px] md:text-[150px] mb-8 bg-blue-100 rounded-full w-48 h-48 md:w-64 md:h-64 flex items-center justify-center border-8 border-white shadow-lg animate-bounce-custom" id="l1-emoji">
                👨‍⚕️
            </div>

            <div class="grid grid-cols-1 gap-4 w-full" id="l1-options">
                <!-- Options generated by JS -->
            </div>
        </div>

        <!-- GAME SCREEN: LEVEL 2 (TEBAK TEMPAT KERJA / DRAG DROP) -->
        <div id="screen-level-2" class="hidden-screen flex-col items-center w-full animate-pop">
            <div class="w-full flex justify-between items-center mb-4">
                <button onclick="showScreen('screen-levels')" class="text-gray-500 text-3xl">🏠</button>
                <div class="bg-yellow-400 text-yellow-900 font-bold px-4 py-2 rounded-full text-xl" id="l2-score">⭐ 0/5</div>
            </div>

            <h2 class="text-xl md:text-2xl font-bold text-center text-blue-600 mb-2" id="l2-question-text">
                Dimana ia bekerja?
            </h2>
            <p class="text-sm text-gray-500 mb-4 text-center">💡 Geser (Drag) pekerja ke tempat yang tepat, atau cukup Sentuh (Tap) tempat kerjanya!</p>

            <div class="flex justify-center mb-8 h-32 md:h-40">
                <div class="text-[80px] md:text-[100px] bg-orange-100 rounded-full w-32 h-32 md:w-40 md:h-40 flex items-center justify-center border-4 border-white shadow-md cursor-grab active:cursor-grabbing transition-transform z-10" id="l2-emoji" draggable="true">
                    👨‍🌾
                </div>
            </div>

            <!-- Workplace Drop Zones -->
            <div class="flex flex-col md:flex-row justify-center gap-4 w-full" id="l2-workplaces">
                <!-- Slots generated by JS -->
            </div>
        </div>

        <!-- RESULT SCREEN -->
        <div id="screen-result" class="hidden-screen flex-col items-center justify-center space-y-6 animate-pop">
            <div class="text-8xl animate-bounce-custom">🎉🌟🎉</div>
            <h2 class="text-4xl font-bold text-center text-green-600">Hebat Sekali!</h2>
            <p class="text-2xl text-gray-700 text-center font-bold">Kamu sudah menyelesaikan level ini!</p>
            <div class="flex flex-col gap-4 w-full mt-6">
                <button onclick="showScreen('screen-levels')" class="btn-game bg-blue-500 text-white text-2xl font-bold py-4 px-8 rounded-full w-full">
                    Pilih Level Lain 🎮
                </button>
            </div>
        </div>

    </div>

    <!-- Overlay Feedback (Correct/Wrong Animation) -->
    <div id="feedback-overlay" class="fixed inset-0 z-50 pointer-events-none flex items-center justify-center hidden">
        <div id="feedback-content" class="text-9xl transform scale-0 transition-transform duration-300">
            ✅
        </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Data Profesi (Professions Data)
        const professions = [
            { name: "DOKTER", emoji: "👨‍⚕️", sound: "Dokter", workplaceName: "Rumah Sakit", workplaceEmoji: "🏥" },
            { name: "POLISI", emoji: "👮‍♂️", sound: "Polisi", workplaceName: "Kantor Polisi", workplaceEmoji: "🚓" },
            { name: "GURU", emoji: "👩‍🏫", sound: "Guru", workplaceName: "Sekolah", workplaceEmoji: "🏫" },
            { name: "PETANI", emoji: "👨‍🌾", sound: "Petani", workplaceName: "Sawah", workplaceEmoji: "🌾" },
            { name: "KOKI", emoji: "👨‍🍳", sound: "Koki", workplaceName: "Restoran", workplaceEmoji: "🍽️" },
            { name: "PILOT", emoji: "👨‍✈️", sound: "Pilot", workplaceName: "Bandara", workplaceEmoji: "✈️" },
            { name: "TENTARA", emoji: "🪖", sound: "Tentara", workplaceName: "Markas", workplaceEmoji: "🏕️" },
            { name: "PEMADAM", emoji: "🧑‍🚒", sound: "Pemadam Kebakaran", workplaceName: "Stasiun Pemadam", workplaceEmoji: "🚒" }
        ];

        let currentLevel = 0;
        let gameQueue = [];
        let currentQuestionIndex = 0;
        let score = 0;
        const totalQuestions = 5; // 5 questions per round
        
        // Level 2 Specific State
        let correctWorkplace = "";

        // Audio Setup (Web Speech API)
        let synth = window.speechSynthesis;
        let indonesianVoice = null;

        // Try to load Indonesian voices
        function loadVoices() {
            let voices = synth.getVoices();
            indonesianVoice = voices.find(voice => voice.lang.includes('id') || voice.lang.includes('ID'));
        }
        loadVoices();
        if (synth.onvoiceschanged !== undefined) {
            synth.onvoiceschanged = loadVoices;
        }

        function speak(text, isPraise = false, isWrong = false) {
            // Remove audio warning on first interaction
            document.getElementById('audio-warning').style.display = 'none';

            if (synth.speaking) {
                synth.cancel();
            }
            const utterThis = new SpeechSynthesisUtterance(text);
            if (indonesianVoice) utterThis.voice = indonesianVoice;
            utterThis.lang = 'id-ID';
            
            // Adjust pitch/rate for kids
            utterThis.rate = 0.9;
            utterThis.pitch = isPraise ? 1.4 : (isWrong ? 0.8 : 1.1);
            
            synth.speak(utterThis);
        }

        // Screen Navigation
        function showScreen(screenId) {
            const screens = ['screen-home', 'screen-levels', 'screen-level-1', 'screen-level-2', 'screen-result'];
            screens.forEach(id => {
                document.getElementById(id).classList.add('hidden-screen');
                document.getElementById(id).classList.remove('flex');
            });
            document.getElementById(screenId).classList.remove('hidden-screen');
            document.getElementById(screenId).classList.add('flex');
        }

        // Shuffle array helper
        function shuffle(array) {
            let currentIndex = array.length, randomIndex;
            while (currentIndex != 0) {
                randomIndex = Math.floor(Math.random() * currentIndex);
                currentIndex--;
                [array[currentIndex], array[randomIndex]] = [array[randomIndex], array[currentIndex]];
            }
            return array;
        }

        // --- GAME LOGIC ---

        function startLevel(level) {
            currentLevel = level;
            score = 0;
            currentQuestionIndex = 0;
            
            // Pick random professions for this round
            gameQueue = shuffle([...professions]).slice(0, totalQuestions);
            
            if (level === 1) {
                showScreen('screen-level-1');
                speak("Tebak nama profesi dari gambar ini!");
                loadLevel1Question();
            } else if (level === 2) {
                showScreen('screen-level-2');
                speak("Dimana tempat kerja mereka?");
                loadLevel2Question();
            }
        }

        function showFeedback(isCorrect) {
            const overlay = document.getElementById('feedback-overlay');
            const content = document.getElementById('feedback-content');
            
            overlay.classList.remove('hidden');
            if (isCorrect) {
                content.innerHTML = '🌟';
                content.className = 'text-[150px] transform scale-100 transition-transform duration-300 drop-shadow-2xl';
                const praises = ["Hebat!", "Pintar!", "Benar sekali!", "Wah jago!"];
                const randomPraise = praises[Math.floor(Math.random() * praises.length)];
                speak(`${randomPraise} Itu adalah ${gameQueue[currentQuestionIndex].sound}`, true);
            } else {
                content.innerHTML = '❌';
                content.className = 'text-[150px] transform scale-100 transition-transform duration-300 drop-shadow-2xl';
                const wrongs = ["Ups salah!", "Coba lagi ya!", "Bukan itu sayang."];
                const randomWrong = wrongs[Math.floor(Math.random() * wrongs.length)];
                speak(randomWrong, false, true);
            }

            setTimeout(() => {
                content.classList.replace('scale-100', 'scale-0');
                setTimeout(() => {
                    overlay.classList.add('hidden');
                }, 300);
            }, 1500);
        }

        function nextQuestion() {
            currentQuestionIndex++;
            if (currentQuestionIndex >= totalQuestions) {
                setTimeout(() => {
                    showScreen('screen-result');
                    speak("Wah, kamu hebat sekali sudah menyelesaikan semuanya!", true);
                }, 1000);
            } else {
                setTimeout(() => {
                    if (currentLevel === 1) loadLevel1Question();
                    if (currentLevel === 2) loadLevel2Question();
                }, 1500);
            }
        }

        // --- LEVEL 1 : TEBAK GAMBAR ---

        function loadLevel1Question() {
            const q = gameQueue[currentQuestionIndex];
            document.getElementById('l1-score').innerText = `⭐ ${score}/${totalQuestions}`;
            
            const emojiEl = document.getElementById('l1-emoji');
            emojiEl.innerText = q.emoji;
            emojiEl.classList.remove('animate-pop');
            void emojiEl.offsetWidth; // trigger reflow
            emojiEl.classList.add('animate-pop');

            // Generate options
            let options = [q];
            let pool = shuffle([...professions]).filter(p => p.name !== q.name);
            options.push(pool[0]);
            options.push(pool[1]);
            options = shuffle(options);

            const optionsContainer = document.getElementById('l1-options');
            optionsContainer.innerHTML = '';
            
            const colors = ['bg-pink-500', 'bg-blue-500', 'bg-purple-500'];

            options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = `btn-game ${colors[idx]} hover:opacity-90 text-white text-3xl font-bold py-5 px-6 rounded-2xl w-full border-4 border-white`;
                btn.innerText = opt.name;
                btn.onclick = () => checkLevel1Answer(opt.name, q.name, btn);
                optionsContainer.appendChild(btn);
            });
        }

        function checkLevel1Answer(selected, correct, btnElement) {
            // Prevent clicking multiple times
            const buttons = document.getElementById('l1-options').querySelectorAll('button');
            buttons.forEach(b => b.disabled = true);

            if (selected === correct) {
                btnElement.classList.replace('bg-pink-500', 'bg-green-500');
                btnElement.classList.replace('bg-blue-500', 'bg-green-500');
                btnElement.classList.replace('bg-purple-500', 'bg-green-500');
                score++;
                document.getElementById('l1-score').innerText = `⭐ ${score}/${totalQuestions}`;
                showFeedback(true);
                nextQuestion();
            } else {
                btnElement.classList.add('animate-shake');
                btnElement.classList.replace('bg-pink-500', 'bg-red-500');
                btnElement.classList.replace('bg-blue-500', 'bg-red-500');
                btnElement.classList.replace('bg-purple-500', 'bg-red-500');
                showFeedback(false);
                setTimeout(() => {
                    buttons.forEach(b => b.disabled = false);
                    btnElement.classList.remove('animate-shake');
                    // Reset color visually
                    loadLevel1Question(); // easy way to reset state
                }, 2000);
            }
        }

        // --- LEVEL 2 : DRAG & DROP TEMPAT KERJA ---

        function loadLevel2Question() {
            const q = gameQueue[currentQuestionIndex];
            document.getElementById('l2-score').innerText = `⭐ ${score}/${totalQuestions}`;
            
            const profEmoji = document.getElementById('l2-emoji');
            profEmoji.innerText = q.emoji;
            profEmoji.style.visibility = 'visible';
            profEmoji.classList.remove('animate-pop');
            void profEmoji.offsetWidth; // trigger reflow
            profEmoji.classList.add('animate-pop');

            document.getElementById('l2-question-text').innerText = `Dimana ${q.sound} bekerja?`;
            speak(`Dimana ${q.sound} bekerja?`);
            correctWorkplace = q.workplaceName;

            // Setup Drag on Emoji
            profEmoji.ondragstart = (e) => {
                e.dataTransfer.setData('text/plain', q.name);
                speak(q.sound);
                setTimeout(() => profEmoji.style.opacity = '0.5', 0);
            };
            profEmoji.ondragend = () => {
                profEmoji.style.opacity = '1';
            };
            profEmoji.onclick = () => {
                speak(q.sound);
            };

            // Generate Options
            let options = [q];
            let pool = shuffle([...professions]).filter(p => p.name !== q.name);
            options.push(pool[0]);
            options.push(pool[1]);
            options = shuffle(options);

            const workplacesContainer = document.getElementById('l2-workplaces');
            workplacesContainer.innerHTML = '';

            options.forEach((opt) => {
                const slotBox = document.createElement('div');
                slotBox.className = 'workplace-slot flex-1 bg-white border-4 border-dashed border-gray-300 rounded-2xl p-4 flex flex-col items-center justify-center cursor-pointer transition-all hover:bg-gray-50';
                
                const emojiSpan = document.createElement('span');
                emojiSpan.className = 'text-6xl md:text-7xl mb-2 pointer-events-none';
                emojiSpan.innerText = opt.workplaceEmoji;
                
                const textSpan = document.createElement('span');
                textSpan.className = 'font-bold text-gray-600 text-lg md:text-xl text-center pointer-events-none';
                textSpan.innerText = opt.workplaceName;

                slotBox.appendChild(emojiSpan);
                slotBox.appendChild(textSpan);

                // Drop logic
                slotBox.ondragover = (e) => {
                    e.preventDefault();
                    slotBox.classList.add('border-blue-500', 'bg-blue-50');
                };
                slotBox.ondragleave = (e) => {
                    slotBox.classList.remove('border-blue-500', 'bg-blue-50');
                };
                slotBox.ondrop = (e) => {
                    e.preventDefault();
                    slotBox.classList.remove('border-blue-500', 'bg-blue-50');
                    checkLevel2Answer(opt.workplaceName, slotBox);
                };
                
                // Tap logic (Mobile alternative to drag & drop)
                slotBox.onclick = () => {
                    checkLevel2Answer(opt.workplaceName, slotBox);
                };

                workplacesContainer.appendChild(slotBox);
            });
        }

        function checkLevel2Answer(selectedWorkplace, slotElement) {
            // Prevent multiple clicks
            if(slotElement.classList.contains('bg-green-100')) return;

            if (selectedWorkplace === correctWorkplace) {
                slotElement.classList.replace('border-dashed', 'border-solid');
                slotElement.classList.replace('border-gray-300', 'border-green-500');
                slotElement.classList.add('bg-green-100');
                
                const profEmoji = document.getElementById('l2-emoji');
                
                // Small animation to show it moving in
                const miniEmoji = document.createElement('span');
                miniEmoji.innerText = profEmoji.innerText;
                miniEmoji.className = 'text-4xl absolute -top-4 -right-4 bg-orange-100 rounded-full w-12 h-12 flex items-center justify-center border-2 border-white shadow animate-pop';
                slotElement.style.position = 'relative';
                slotElement.appendChild(miniEmoji);

                profEmoji.style.visibility = 'hidden';

                score++;
                document.getElementById('l2-score').innerText = `⭐ ${score}/${totalQuestions}`;
                showFeedback(true);
                
                // Disable other options temporarily
                Array.from(document.getElementById('l2-workplaces').children).forEach(el => el.onclick = null);

                nextQuestion();
            } else {
                slotElement.classList.add('animate-shake', 'border-red-500', 'bg-red-100');
                showFeedback(false);
                setTimeout(() => {
                    slotElement.classList.remove('animate-shake', 'border-red-500', 'bg-red-100');
                }, 1000);
            }
        }

        // Setup global click listener to unlock audio on first interaction
        document.body.addEventListener('click', () => {
            document.getElementById('audio-warning').style.display = 'none';
        }, { once: true });

    </script>
</body>
</html>
